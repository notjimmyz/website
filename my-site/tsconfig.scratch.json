{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": ".tmp-berkeley",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "scratch-berkeley-render.ts",
    "src/components/scene/environments/IsoBerkeleyCampus.tsx",
    "src/components/scene/environments/iso/**/*"
  ]
}
